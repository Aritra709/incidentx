# Optional LLM reasoning layer (OpenAI-compatible endpoint).
# Leave empty to run fully deterministic rules-only mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
INCIDENTX_LLM_MODEL=gpt-4o-mini
# auto = use LLM when a key/base URL is configured; false = rules only
INCIDENTX_LLM_ENABLED=auto
INCIDENTX_LLM_TIMEOUT=20
